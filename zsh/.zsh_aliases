alias gsfzf='git switch $(gb | fzf)'
alias gai="git add -i"
alias gfa="git forgit add"
alias gdh="git diff HEAD~1"
alias gcanm="git commit --all --no-verify --message"
alias gcnn!="git commit --no-verify --no-edit --amend"

alias gfsw="git-fetch-switch"
alias gfcb="git-fetch-checkout-branch"
alias ghpf="git-fetch-checkout-pr" # worktree-compatible version of ghph (gh pr checkout)
alias gfdcb="git-fetch-development-create-branch"
alias gfod="gfo development"
alias gfodd="gfo development:development"

alias gcb='git rev-parse --abbrev-ref HEAD'

alias ghpce='gh pr create -e'
alias ghpcd='gh pr create -e -d'
alias ghpm='gh pr merge --auto --merge'
alias ghph='gh pr checkout'
alias ghpv='gh pr view -w'
alias ghps='gh pr status'

export DERIVED_DATA="$HOME/Library/Developer/Xcode/DerivedData"

function git-fetch-switch() {
  if [ -z "$1" ]; then
    echo "Usage: git-fetch-switch <branch-name>"
    return 1
  fi

  local branch="$1"
  gfo "$branch:$branch"
  gsw "$branch"
}

function git-fetch-checkout-pr() {
  if [ -z "$1" ]; then
    echo "Usage: git-fetch-checkout-pr <pr-number>"
    return 1
  fi

  local branch
  branch=$(gh pr view "$1" --json headRefName --jq '.headRefName')
  if [ -z "$branch" ]; then
    echo "Could not find branch for PR $1"
    return 1
  fi

  git-fetch-checkout-branch "$branch"
}

function git-fetch-checkout-branch() {
  if [ -z "$1" ]; then
    echo "Usage: git-fetch-checkout-branch <branch-name>"
    return 1
  fi

  local branch="$1"
  git fetch origin "$branch"
  if git show-ref --verify --quiet "refs/heads/$branch"; then
    git checkout "$branch"
    git reset --hard FETCH_HEAD
  else
    git checkout -b "$branch" FETCH_HEAD
  fi
}

function git-fetch-development-create-branch() {
  if [ -z "$1" ]; then
    echo "Usage: git-fetch-development-create-branch <branch-name>"
    return 1
  fi

  local branch="$1"
  gfo development:development
  gswc "$branch"
}

function mkdir-cp() {
  if [ $# -lt 2 ]; then
    echo "Usage: mkdir-cp <source> <destination>"
    return 1
  fi

  local dest="$2"

  # If destination ends with /, treat it as a directory
  if [[ "$dest" == */ ]]; then
    mkdir -p "$dest"
  else
    # Create parent directory of the destination file
    local dest_dir="$(dirname "$dest")"
    mkdir -p "$dest_dir"
  fi

  cp "$1" "$2"
}

# Backup branches: <current-branch>-<n>-<postfix>
unalias gbb gbbr gbbc gbbrc 2>/dev/null

# Print highest backup number for the current branch (0 if none)
function _gbb_max() {
  local cur="$1" b rest n max=0
  for b in ${(f)"$(git for-each-ref --format='%(refname:short)' refs/heads)"}; do
    [[ "$b" == "$cur"-* ]] || continue
    rest="${b#"$cur"-}"
    n="${rest%%-*}"
    [[ "$n" == <-> ]] && (( n > max )) && max=$n
  done
  echo $max
}

# gbb [postfix words...] - create a backup branch of the current branch
function gbb() {
  local cur
  cur="$(git branch --show-current)" || return 1
  if [[ -z "$cur" ]]; then
    echo "gbb: not on a branch (detached HEAD?)" >&2
    return 1
  fi

  local n=$(( $(_gbb_max "$cur") + 1 ))
  local name="$cur-$n"
  if (( $# )); then
    local postfix="${(j:-:)@}"
    postfix="${postfix// /-}"
    name="$name-$postfix"
  fi

  git branch "$name" || return 1
  echo "$name"
}

# gbbr [n] - print backup branch name for number n (latest if omitted)
function gbbr() {
  local cur
  cur="$(git branch --show-current)" || return 1
  if [[ -z "$cur" ]]; then
    echo "gbbr: not on a branch (detached HEAD?)" >&2
    return 1
  fi

  local n="$1"
  if [[ -z "$n" ]]; then
    n="$(_gbb_max "$cur")"
    if (( n == 0 )); then
      echo "gbbr: no backup branches for $cur" >&2
      return 1
    fi
  elif [[ "$n" != <-> ]]; then
    echo "Usage: gbbr [number]" >&2
    return 1
  fi

  local b
  for b in ${(f)"$(git for-each-ref --format='%(refname:short)' "refs/heads/$cur-$n" "refs/heads/$cur-$n-*")"}; do
    echo "$b"
    return 0
  done
  echo "gbbr: no backup #$n for $cur" >&2
  return 1
}

# gbbc - copy current branch name to clipboard
function gbbc() {
  local cur
  cur="$(git branch --show-current)" || return 1
  if [[ -z "$cur" ]]; then
    echo "gbbc: not on a branch (detached HEAD?)" >&2
    return 1
  fi
  printf '%s' "$cur" | pbcopy
  echo "$cur"
}

# gbbrc [n] - copy backup branch name for number n (latest if omitted) to clipboard
function gbbrc() {
  local name
  name="$(gbbr "$@")" || return 1
  printf '%s' "$name" | pbcopy
  echo "$name"
}
